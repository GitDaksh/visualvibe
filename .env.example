# Copy this file to .env.local and fill in the values.

# Clerk (dashboard.clerk.com → your app → API keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# Stream (dashboard.getstream.io → your app → API key and secret)
NEXT_PUBLIC_STREAM_API_KEY=xxx
STREAM_SECRET_KEY=xxx

# Optional: your deployed URL, used in invite links and social previews.
# Leave it out and links use whatever address the app is opened at.
# NEXT_PUBLIC_BASE_URL=https://visualvibe.vercel.app

# Optional cost guardrails (defaults shown).
# Meetings end themselves after this many minutes; personal rooms close the
# session for everyone at this point too. Anyone past the participant limit
# can't join.
# CALL_MAX_DURATION_MINUTES=120
# CALL_MAX_PARTICIPANTS=10
